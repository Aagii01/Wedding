{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/invite.js": { "includeFiles": "dist/index.html" }
  },
  "rewrites": [
    { "source": "/i/:slug", "destination": "/api/invite?slug=:slug" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
