/*
 * ============================================================================
 * ИДЭВХГҮЙ — Facebook/Messenger линк preview (OG meta tags)
 * ============================================================================
 *
 * Юу хийдэг вэ:
 *   /i/:slug линкийг Facebook-д хуваалцахад зураг + нэр + огноотой preview
 *   гаргах. Facebook-ийн crawler JavaScript ажиллуулдаггүй тул meta tag-ийг
 *   серверээс HTML дотор шингээж өгөх ёстой.
 *
 * Яагаад идэвхгүй байгаа вэ:
 *   Шинэ загвар хийх ажил түрүүлсэн. Код бүрэн бичигдэж, тестлэгдсэн —
 *   зөвхөн идэвхжүүлэх л үлдсэн.
 *
 * ЯАЖ ИДЭВХЖҮҮЛЭХ (2 алхам):
 *
 *   1) Энэ файлыг `api/invite.js` болгож нэрлэ, доорх коммент хашилтыг ав.
 *      (`.disabled` өргөтгөлтэй байхад Vercel үүнийг function болгон
 *       бүтээхгүй — тиймээс одоо деплойд огт нөлөөлөхгүй.)
 *
 *   2) vercel.json-д дараах 2 зүйлийг нэм:
 *
 *        "functions": {
 *          "api/invite.js": { "includeFiles": "dist/index.html" }
 *        },
 *        "rewrites": [
 *          { "source": "/i/:slug", "destination": "/api/invite?slug=:slug" },
 *          { "source": "/(.*)", "destination": "/index.html" }
 *        ]
 *
 *      ⚠️ Дараалал чухал: /i/:slug мөр нь /(.*) мөрөөс ӨМНӨ байх ёстой.
 *
 * Тестлэсэн үр дүн (2026-07-21):
 *   ✓ dashkhuu-sumyakhuukhen → "Бямбадоржийн Дашхүү & Мэндсайханы
 *     Сумъяахүүхэн — Хуримын урилга" + og:image зөв гарсан
 *   ✓ 12v-reunion (нэргүй) → event.title-руу зөв уналаа
 *   ✓ байхгүй slug → алдаа заахгүй, хуучин title-аар хэвийн ачаална
 *   ✓ build-ийн <script src="/assets/index-*.js"> бүрэн үлдсэн
 *
 * ⚠️ ҮЛДСЭН АСУУДАЛ — зургийн харьцаа:
 *   Facebook preview-г 1.91:1 ХЭВТЭЭ харьцаагаар тайрдаг. Гэтэл одоогийн
 *   main_image-ийн ихэнх нь БОСОО (736x1104, 768x1151, 736x1032, 720x1079).
 *   Preview гарна, гэхдээ дундаас нь нарийн зурвас огтолж авах тул толгой
 *   тасарч магадгүй.
 *   Шийдэл: events хүснэгтэд `og_image` багана нэмж, event бүрт 1200x630
 *   зураг оруулах. Дараа нь энэ файлын FIELDS-д og_image нэмээд
 *   `event.og_image || event.main_image` болгож ашиглана.
 *   ⚠️ og_image баганыг ҮҮСГЭХЭЭС ӨМНӨ FIELDS-д нэмбол Supabase 400
 *   алдаа буцааж, бүх урилгын preview унана.
 *
 * Идэвхжүүлсний дараа Facebook Sharing Debugger-ээр шалга:
 *   https://developers.facebook.com/tools/debug/
 *   (Facebook OG датаг cache хийдэг тул "Scrape Again" дарах хэрэгтэй.)
 * ============================================================================

import { readFile } from "node:fs/promises";
import { join } from "node:path";

const SUPABASE_URL = process.env.VITE_SUPABASE_URL;
const SUPABASE_KEY = process.env.VITE_SUPABASE_ANON_KEY;

const FIELDS =
  "title,type,date,venue_name,main_image,person1_name,person2_name";

let cachedShell = null;

// Build-ээс гарсан index.html-ийг уншина (disk → fetch fallback).
async function getShell(host) {
  if (cachedShell) return cachedShell;
  try {
    cachedShell = await readFile(join(process.cwd(), "dist/index.html"), "utf8");
  } catch {
    const res = await fetch(`https://${host}/index.html`);
    cachedShell = await res.text();
  }
  return cachedShell;
}

function esc(value) {
  return String(value ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

// "2026-07-15" → "2026 оны 7 сарын 15"
function formatDate(date) {
  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(date ?? "");
  if (!m) return "";
  return `${m[1]} оны ${Number(m[2])} сарын ${Number(m[3])}`;
}

const KIND = {
  wedding: "Хуримын урилга",
  birthday: "Төрсөн өдрийн урилга",
  reunion: "Уулзалтын урилга",
};

function buildTags(event, url) {
  const names = [event.person1_name, event.person2_name]
    .map((name) => name?.trim())
    .filter(Boolean)
    .join(" & ");
  const kind = KIND[event.type] || "Урилга";

  const title = names ? `${names} — ${kind}` : event.title || kind;
  const description = [formatDate(event.date), event.venue_name]
    .filter(Boolean)
    .join(" · ");

  const tags = [
    `<meta property="og:type" content="website" />`,
    `<meta property="og:site_name" content="One Wedding" />`,
    `<meta property="og:url" content="${esc(url)}" />`,
    `<meta property="og:title" content="${esc(title)}" />`,
    `<meta property="og:locale" content="mn_MN" />`,
    `<meta name="twitter:card" content="${event.main_image ? "summary_large_image" : "summary"}" />`,
    `<meta name="twitter:title" content="${esc(title)}" />`,
  ];

  if (description) {
    tags.push(
      `<meta name="description" content="${esc(description)}" />`,
      `<meta property="og:description" content="${esc(description)}" />`,
      `<meta name="twitter:description" content="${esc(description)}" />`,
    );
  }
  if (event.main_image) {
    tags.push(
      `<meta property="og:image" content="${esc(event.main_image)}" />`,
      `<meta name="twitter:image" content="${esc(event.main_image)}" />`,
    );
  }

  return { title, tags: tags.join("\n    ") };
}

export default async function handler(req, res) {
  const host = req.headers["x-forwarded-host"] || req.headers.host;
  const slug = String(req.query.slug || "").replace(/[^a-zA-Z0-9_-]/g, "");

  let html = await getShell(host);

  try {
    const query = `${SUPABASE_URL}/rest/v1/events?slug=eq.${slug}&select=${FIELDS}&limit=1`;
    const response = await fetch(query, {
      headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${SUPABASE_KEY}` },
    });
    const [event] = await response.json();

    if (event) {
      const { title, tags } = buildTags(event, `https://${host}/i/${slug}`);
      html = html
        .replace(/<title>.*?<\/title>/, `<title>${esc(title)}</title>`)
        .replace("</head>", `  ${tags}\n    </head>`);
    }
  } catch {
    // Дата авч чадаагүй ч урилга нь хэвийн ачаална — зөвхөн preview л дутна.
  }

  res.setHeader("Content-Type", "text/html; charset=utf-8");
  res.setHeader("Cache-Control", "public, s-maxage=300, stale-while-revalidate=86400");
  res.status(200).send(html);
}

 * ============================================================================
 */
